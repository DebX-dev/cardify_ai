# ---------- App ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4200
APP_NAME=Cardify AI

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017/cardify_ai
MONGODB_DB_NAME=cardify_ai

# ---------- Google Gemini (FREE TIER) ----------
# Get a free key: https://aistudio.google.com/apikey
# Do NOT link a billing account — linked billing switches to paid tier.
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated fallback chain, tried in order when the primary is overloaded (503/429)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash
# Thinking tokens share the output budget; MINIMAL keeps JSON from being truncated (MINIMAL/LOW/MEDIUM/HIGH/OFF)
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_MAX_TOKENS_VARIANTS=900
GEMINI_MAX_TOKENS_SCORECARD=1200
GEMINI_TEMPERATURE=0.7
GEMINI_TEMPERATURE_SCORECARD=0.3

# ---------- AI Guardrails ----------
GEMINI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=v1

# ---------- Local In-Memory Cache ----------
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=200

# ---------- Rate Limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=20

# ---------- Swagger ----------
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs

# ---------- Logging ----------
LOG_LEVEL=info
